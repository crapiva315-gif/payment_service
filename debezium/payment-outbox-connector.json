{
  "connector.class": "io.debezium.connector.mongodb.MongoDbConnector",
  "tasks.max": "1",
  "mongodb.connection.string": "mongodb://mongodb:27017/?replicaSet=rs0",
  "topic.prefix": "payments",
  "database.include.list": "payments_db",
  "collection.include.list": "payments_db.outbox",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.storage.StringConverter",
  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.connector.mongodb.transforms.outbox.MongoEventRouter",
  "transforms.outbox.route.topic.replacement": "payment-events",
  "transforms.outbox.collection.fields.additional.placement": "type:header:eventType"
}